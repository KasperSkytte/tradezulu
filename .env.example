# ---------------------------------------------------------------------------
# TradeZulu configuration. ./install.sh writes a .env with generated secrets;
# to do it by hand, copy this to .env and edit it before the first start.
# ---------------------------------------------------------------------------

# Signs the session cookie, and encrypts the MetaTrader passwords stored in
# the database -- lose it and they cannot be read.  openssl rand -base64 48
TZ_SECRET_KEY=change-me-to-a-long-random-string

# The single journal account. The user is created on first start only;
# afterwards change the password from the Settings page.
TZ_ADMIN_USER=admin
TZ_ADMIN_PASSWORD=change-me-before-first-start

# What the terminals and their Expert Advisors authenticate with, and what the
# orchestrator reads its plan with.  openssl rand -hex 24
TZ_INGEST_TOKEN=change-me-as-well

# Your MetaTrader accounts are NOT configured here. Add them in the app under
# Accounts; passwords are encrypted at rest rather than sitting in this file.
# The weekly terminal restart is set in the app too, on the Accounts page.

# Set to true when TradeZulu is served over HTTPS (recommended behind nginx).
TZ_COOKIE_SECURE=false

# How long a login stays valid.
TZ_SESSION_DAYS=30

# Port published on the host, on 127.0.0.1 only; nginx should proxy to this.
TZ_PORT=8420

# Which published app and orchestrator images docker compose uses. Until a
# release has published them, `docker compose up -d --build` builds both
# locally and these can stay as they are. Terminal images are always built
# locally, with terminal/build.sh.
TZ_IMAGE_OWNER=local
TZ_IMAGE_TAG=latest

# Only for running a second stack beside the first on one machine (a test
# install, say): every name below must then differ from the first stack's,
# and so must TZ_PORT. Terminal containers are named <TZ_STACK>-terminal-<id>.
# COMPOSE_PROJECT_NAME matters most: without it compose names the project
# after the directory, and two checkouts both called "tradezulu" are one
# project to it.
# COMPOSE_PROJECT_NAME=tradezulu
# TZ_CONTAINER_NAME=tradezulu
# TZ_ORCHESTRATOR_NAME=tradezulu-orchestrator
# TZ_NETWORK=tradezulu
# TZ_STACK=tradezulu

# Fill the journal with generated trades on first start so you can look
# around before connecting MetaTrader. Leave unset for real use.
# TZ_DEMO=1

# INFO or DEBUG
TZ_LOG_LEVEL=INFO
