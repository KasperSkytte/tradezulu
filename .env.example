# ---------------------------------------------------------------------------
# TradeZulu configuration. Copy to .env and edit before the first start.
# ---------------------------------------------------------------------------

# Signs the session cookie. Generate one with:  openssl rand -base64 48
TZ_SECRET_KEY=change-me-to-a-long-random-string

# The single journal account. The user is created on first start only;
# afterwards change the password from the Settings page.
TZ_ADMIN_USER=kasper
TZ_ADMIN_PASSWORD=change-me-before-first-start

# Shared secret between TradeZulu and the MetaTrader terminal container.
# Generate one with:  openssl rand -hex 24
TZ_BRIDGE_TOKEN=change-me-as-well

# Only needed if you use the TradeZuluSync Expert Advisor instead of, or as
# well as, the terminal container.  openssl rand -hex 24
TZ_INGEST_TOKEN=change-me-too

# Your MetaTrader account is NOT configured here. Enter the server, account
# number and investor password in the app under Settings -> MetaTrader 5;
# the password is encrypted at rest rather than sitting in this file.

# Only for a broker whose terminal the generic MetaQuotes installer cannot
# fetch — point this at their own installer instead.
# MT5_SETUP_URL=

# Set to 1 to expose a VNC view of the terminal for troubleshooting. You must
# also publish port 5900 on the mt5-bridge service.
MT5_ENABLE_VNC=0

# Set to true when TradeZulu is served over HTTPS (recommended behind nginx).
TZ_COOKIE_SECURE=false

# How long a login stays valid.
TZ_SESSION_DAYS=30

# Port published on the host; nginx should proxy to this.
TZ_PORT=8420

# Which published image docker compose should use. Only needed once the
# repository is on GitHub and a release has built an image; until then
# `docker compose up -d --build` builds it locally and these are ignored.
TZ_IMAGE_OWNER=your-github-username
TZ_IMAGE_TAG=latest

# Fill the journal with generated trades on first start so you can look
# around before connecting MetaTrader. Leave unset for real use.
# TZ_DEMO=1

# INFO or DEBUG
TZ_LOG_LEVEL=INFO
